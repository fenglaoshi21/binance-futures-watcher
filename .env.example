# ============================================================
# 环境变量模板 - 复制为 .env 后填入真实值
# .env 已加入 .gitignore，不会提交到公开仓库
# ============================================================

# ---- Supabase ----
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_ANON_KEY=your_anon_key

# ---- Coinglass/LSR 主力 API (vip2.coinglass.site) ----
# 鉴权：Header X-API-Key
# 频率：Coinglass 10次/60秒，LSR 10次/60秒（独立额度）
VIP2_API_URL=https://vip2.coinglass.site
VIP2_API_KEY=cg_your_key_here

# ---- Coinglass 备用 API (alphanode.work) ----
# 鉴权：Header x-key
# 频率：1次/分钟
ALPHANODE_API_URL=https://api.alphanode.work
ALPHANODE_API_KEY=myapi_sk_your_key_here

# ---- 通义千问 (DashScope) ----
DASHSCOPE_API_KEY=sk-xxx
# 生成报告用的模型
QWEN_MODEL=qwen-turbo
# 向量嵌入模型（维度1536，匹配pgvector vector(1536)）
QWEN_EMBEDDING_MODEL=text-embedding-v1

# ---- 应用配置 ----
# 扫描间隔（分钟），与cron-job.org配置一致
SCAN_INTERVAL_MINUTES=30
# coins-markets 每次取多少条（最大100）
COINGLASS_PER_PAGE=100
# RAG检索相似历史记录条数
RAG_TOP_K=3
# 调试模式
DEBUG=true
